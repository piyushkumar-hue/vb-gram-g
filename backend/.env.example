PORT=53184
MONGODB_URI=mongodb://127.0.0.1:27017/vb_gram_g
# Must point to an isolated database; database-backed automated tests must refuse the main database.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/vb_gram_g_test
# Optional connection tuning for hosted MongoDB / Atlas.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
MONGODB_CONNECT_TIMEOUT_MS=15000
MONGODB_RETRY_DELAY_MS=5000
# Optional: DNS resolver IP for MongoDB SRV lookups when Node's default resolver is unreachable.
# MONGODB_DNS_SERVER=
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 only when requests arrive through exactly one trusted reverse proxy.
TRUST_PROXY=0
# Generate a strong value with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Generate a different strong value using the same command.
FIELD_DEVICE_API_KEY=replace-with-a-separate-random-key
# Optional bootstrap admin values for `npm run create-admin`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Demo-only shared password for the three accounts created by npm run seed-demo.
# Use a disposable demo/test database; this is not a production account setting.
DEMO_ACCOUNT_PASSWORD=