# Set this to the deployed backend origin when frontend and backend are hosted separately.
# Example: https://your-api.onrender.com
VITE_API_BASE_URL=

# Optional public URL for a verified GeoJSON FeatureCollection. This is not a secret.
# Example local file path after you provide and verify the data: /data/district-boundaries.geojson
VITE_DISTRICT_GEOJSON_URL=
